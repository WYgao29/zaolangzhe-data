# 本地中文总结环境配置（launchd 与手动运行共用）
# 复制为 local/env 后按你的本地模型服务修改；local/env 不入库，凭据不要写进仓库。
# 端点为任意 OpenAI 兼容服务：mlx_lm.server（默认 8080）、LM Studio（1234）、Ollama（11434/v1）。

AI_PROVIDER=openai
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODEL=your-local-model-name

# 可选：本地跑长转录建议放大超时、降低并发
# AI_TIMEOUT_MS=600000
# AI_CONCURRENCY=1
